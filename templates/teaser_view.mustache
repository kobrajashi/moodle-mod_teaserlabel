{{!
    @template mod_teaserlabel/teaser_view

    Template for teaser display on the course page.

    Context variables required:
    * teasertext - The formatted teaser text HTML
    * mediahtml - The media element HTML (image or video)
    * mediaposition - Position class (left, right, top, bottom, center)
    * mediasize - Size class (small, medium, large, original)
    * readmoreurl - URL to the full content view
    * readmoretext - Text for the read more link

    Example context (json):
    {
        "teasertext": "<p>This is a teaser...</p>",
        "mediahtml": "<img src=\"image.jpg\" alt=\"\" class=\"teaserlabel-image\" />",
        "mediaposition": "left",
        "mediasize": "medium",
        "readmoreurl": "/mod/teaserlabel/view.php?id=1",
        "readmoretext": "Read more..."
    }
}}
<div class="teaserlabel-teaser teaserlabel-media-{{mediaposition}}">
    {{#mediahtml}}
        {{#medialeft}}
            <div class="teaserlabel-media teaserlabel-size-{{mediasize}}">
                {{{mediahtml}}}
            </div>
        {{/medialeft}}
    {{/mediahtml}}

    <div class="teaserlabel-text">
        {{{teasertext}}}
    </div>

    {{#mediahtml}}
        {{#mediaright}}
            <div class="teaserlabel-media teaserlabel-size-{{mediasize}}">
                {{{mediahtml}}}
            </div>
        {{/mediaright}}
    {{/mediahtml}}

    <div class="teaserlabel-readmore">
        <a href="{{readmoreurl}}">{{readmoretext}}</a>
    </div>
</div>
