{{!
    @template mod_teaserlabel/full_view

    Template for the full content view page.

    Context variables required:
    * hasteaser - Whether the teaser section should be shown
    * teasertext - The formatted teaser text HTML
    * mediahtml - The media element HTML
    * fullcontent - The formatted full content HTML
    * backtocourseurl - URL back to the course
    * backtocoursetext - Text for the back link

    Example context (json):
    {
        "hasteaser": true,
        "teasertext": "<p>This is a teaser...</p>",
        "mediahtml": "<img src=\"image.jpg\" alt=\"\" class=\"teaserlabel-image\" />",
        "fullcontent": "<p>Full content here...</p>",
        "backtocourseurl": "/course/view.php?id=1",
        "backtocoursetext": "Back to course"
    }
}}
{{#hasteaser}}
<div class="teaserlabel-full-teaser">
    {{#mediahtml}}
        <div class="teaserlabel-media">
            {{{mediahtml}}}
        </div>
    {{/mediahtml}}
    <div class="teaserlabel-teaser-text">
        {{{teasertext}}}
    </div>
</div>
{{/hasteaser}}

<div class="teaserlabel-fullcontent">
    {{{fullcontent}}}
</div>

<div class="teaserlabel-backlink">
    <a href="{{backtocourseurl}}">{{backtocoursetext}}</a>
</div>
