<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/teaserlabel/db" VERSION="20260203" COMMENT="XMLDB file for Moodle mod_teaserlabel">
  <TABLES>
    <TABLE NAME="teaserlabel" COMMENT="Stores teaserlabel instances">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="useteaser" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" COMMENT="0=no teaser, 1=use teaser"/>
        <FIELD NAME="teasertext" TYPE="text" NOTNULL="false" COMMENT="Teaser content"/>
        <FIELD NAME="teasertextformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="teasermediatype" TYPE="char" LENGTH="10" NOTNULL="false" COMMENT="image or video"/>
        <FIELD NAME="teasermediaposition" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="left" COMMENT="left,right,top,bottom,center"/>
        <FIELD NAME="teasermediasize" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="medium" COMMENT="small,medium,large,original"/>
        <FIELD NAME="fullcontent" TYPE="text" NOTNULL="false" COMMENT="Full content shown on view page"/>
        <FIELD NAME="fullcontentformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
